LEXICORE_PORT=3000
MAX_UPLOAD_MB=50
ANALYSIS_RATE_LIMIT_PER_MIN=6
EXTERNAL_HEALTH_RATE_LIMIT_PER_MIN=10
# Set to 1 only when running behind a trusted reverse proxy/tunnel.
TRUST_PROXY=0
# Optional comma-separated browser origins. Leave blank for same-origin deployment.
# Example: ALLOWED_ORIGINS=https://lexicore.example.com
ALLOWED_ORIGINS=
