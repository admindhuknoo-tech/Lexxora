{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "drafting:sources:sync": "node scripts/sync-official-drafting-sources.mjs",
    "audit:deep": "node scripts/audit-baseline.mjs && node scripts/audit-deep.mjs",
    "cleanup:dead-frontend": "node scripts/cleanup-dead-frontend.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@types/multer": "^2.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
