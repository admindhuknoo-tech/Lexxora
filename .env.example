PORT=3000
APP_URL="http://localhost:3000"
# off | desktop | web
LEXICORE_RUNTIME_MODE=off

# Web V7.1 authentication/session (required in production, >=32 chars)
LEXICORE_SESSION_SECRET=
LEXICORE_WEB_DATA_DIR=./data
LEXICORE_ADMIN_SECRET=

# Web pricing. Defaults remain available for sandbox; explicitly confirm before production charging.
WEB_LICENSE_DAY_PRICE_RP=15000
WEB_LICENSE_WEEK_PRICE_RP=75000
WEB_LICENSE_MONTH_PRICE_RP=250000
WEB_DEMO_DAYS=3
LEXICORE_PRICING_CONFIRMED=0

# Midtrans Snap: 0=sandbox, 1=production
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=0
