+
+// Named foundational codified instrument(s) (e.g. "Kitab Undang-Undang Hukum
+// Perdata") for the case's classified domain(s). Unlike topical/anchor terms,
+// these are meant to be issued as their own standalone, undiluted discovery
+// query — mixing them into a longer ontology query buries the exact title
+// under courtroom-language terms and loses the identity-style match a named
+// code is otherwise well-placed to win.
+export function coreInstrumentQueriesForContext(text: string): string[] {
+  const context = inferLegalContext(text);
+  const active = [context.primary, ...context.secondary].filter(x => x.profile);
+  return [...new Set(active.flatMap(x => x.profile!.core_instruments || []))].slice(0, 4);
 }
